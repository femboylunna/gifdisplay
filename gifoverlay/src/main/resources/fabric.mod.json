	"authors": ["You"],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.gifoverlay.GifOverlayClient"]
	},
	"mixins": ["gifoverlay.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
